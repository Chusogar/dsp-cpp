# Helpers for the CMake-based ports (ports/rp2350-pizero, ports/common/host):
# the dsp sources of the chosen drivers, the generated dsp_drivers.h, zlib and
# the embedded media.
#
#   include(${DSP_REPO}/ports/common/dsp_port.cmake)
#   dsp_port_add_sources(my_firmware DRIVERS galaxian blockout
#                        ZLIB_DIR ${zlib_src} [EMBED ${embedded_c}])
#
# The source list of each driver comes from ports/common/driver_sources.cmake,
# generated by tools/driver_sources.py from a desktop build.

get_filename_component(DSP_REPO "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(DSP_PORT_COMMON "${DSP_REPO}/ports/common")
include(${DSP_REPO}/cmake/drivers.cmake)
include(${DSP_PORT_COMMON}/driver_sources.cmake)

# Drivers that cannot run on the boards: Model 3 needs threads and C++
# exceptions (and far more RAM); the Macintosh II's 68020 core (Musashi) has
# ~850 KB of tables in RAM. Left out of the groups, refused by name.
set(DSP_PORT_UNSUPPORTED model3 macii)

# Driver names from a list that may hold the groups arcade/consoles/computers/all.
function(dsp_port_resolve_drivers out)
  set(result "")
  foreach(item IN LISTS ARGN)
    string(REPLACE "," ";" parts "${item}")
    foreach(d IN LISTS parts)
      string(STRIP "${d}" d)
      string(TOLOWER "${d}" d)
      if(d STREQUAL "")
        continue()
      elseif(d STREQUAL "all")
        list(APPEND result ${DSP_DRIVERS_ALL})
      elseif(d STREQUAL "arcade")
        list(APPEND result ${DSP_DRIVERS_ARCADE})
      elseif(d STREQUAL "consoles" OR d STREQUAL "console")
        list(APPEND result ${DSP_DRIVERS_CONSOLES})
      elseif(d STREQUAL "computers" OR d STREQUAL "computer")
        list(APPEND result ${DSP_DRIVERS_COMPUTERS})
      elseif(d IN_LIST DSP_PORT_UNSUPPORTED)
        message(FATAL_ERROR "dsp port: the ${d} driver is not supported on microcontrollers")
      elseif(d IN_LIST DSP_DRIVERS_ALL)
        list(APPEND result ${d})
      else()
        string(REPLACE ";" " " valid "${DSP_DRIVERS_ALL}")
        message(FATAL_ERROR "dsp port: unknown driver '${d}'. Valid names: ${valid}")
      endif()
    endforeach()
  endforeach()
  if(result STREQUAL "")
    message(FATAL_ERROR "dsp port: no drivers chosen")
  endif()
  list(REMOVE_DUPLICATES result)
  list(REMOVE_ITEM result ${DSP_PORT_UNSUPPORTED})
  set(${out} ${result} PARENT_SCOPE)
endfunction()

# C file with the embedded media of one game, from the DSP_EMBED_* variables
# (same meaning as in the top-level CMakeLists.txt). Sets `out` to the file,
# or to "" when nothing is embedded.
function(dsp_port_embedded_media out)
  set(${out} "" PARENT_SCOPE)
  if(DSP_EMBED_ENTRIES)  # several games: "LABEL=COMMAND LINE;..."
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    set(c_file ${CMAKE_CURRENT_BINARY_DIR}/embedded_media.c)
    set(cmd ${Python3_EXECUTABLE} ${DSP_REPO}/tools/embed_media.py -o ${c_file})
    foreach(e IN LISTS DSP_EMBED_ENTRIES)
      list(APPEND cmd "--entry=${e}")
    endforeach()
    add_custom_command(OUTPUT ${c_file} COMMAND ${cmd} DEPENDS ${DSP_REPO}/tools/embed_media.py VERBATIM
                       COMMENT "Embedding the built-in games")
    message(STATUS "dsp port: built-in games: ${DSP_EMBED_ENTRIES}")
    set(${out} ${c_file} PARENT_SCOPE)
    return()
  endif()
  if(DSP_EMBED_C)
    get_filename_component(c_abs "${DSP_EMBED_C}" ABSOLUTE)
    set(${out} ${c_abs} PARENT_SCOPE)
    return()
  endif()
  if(NOT DSP_EMBED_ROM)
    return()
  endif()
  if(NOT DSP_EMBED_GAME)
    message(FATAL_ERROR "DSP_EMBED_ROM needs DSP_EMBED_GAME (the --game name to start)")
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  get_filename_component(rom_abs "${DSP_EMBED_ROM}" ABSOLUTE)
  set(c_file ${CMAKE_CURRENT_BINARY_DIR}/embedded_media.c)
  set(cmd ${Python3_EXECUTABLE} ${DSP_REPO}/tools/embed_media.py -o ${c_file}
      --game ${DSP_EMBED_GAME} --rom ${rom_abs})
  set(deps ${DSP_REPO}/tools/embed_media.py)
  if(IS_DIRECTORY "${rom_abs}")
    file(GLOB_RECURSE rom_files CONFIGURE_DEPENDS "${rom_abs}/*")
    list(APPEND deps ${rom_files})
  else()
    list(APPEND deps ${rom_abs})
  endif()
  foreach(kind TAPE DISK CART)
    string(TOLOWER ${kind} option)
    foreach(f IN LISTS DSP_EMBED_${kind})
      get_filename_component(f_abs "${f}" ABSOLUTE)
      list(APPEND cmd --${option} ${f_abs})
      list(APPEND deps ${f_abs})
    endforeach()
  endforeach()
  foreach(a IN LISTS DSP_EMBED_ARGS)
    list(APPEND cmd "--arg=${a}")
  endforeach()
  add_custom_command(OUTPUT ${c_file} COMMAND ${cmd} DEPENDS ${deps} VERBATIM
                     COMMENT "Embedding the media of ${DSP_EMBED_GAME}")
  message(STATUS "dsp port: embedded media for --game ${DSP_EMBED_GAME} (${DSP_EMBED_ROM})")
  set(${out} ${c_file} PARENT_SCOPE)
endfunction()

# Adds to `target` everything the port needs for DRIVERS: their dsp sources,
# the registry, the port core, zlib (ZLIB_DIR = zlib source tree) and the
# embedded media (EMBED = C file; none when empty).
function(dsp_port_add_sources target)
  cmake_parse_arguments(ARG "" "EMBED;ZLIB_DIR" "DRIVERS" ${ARGN})
  dsp_port_resolve_drivers(drivers ${ARG_DRIVERS})

  set(rel ${DSP_PORT_CORE_SOURCES} src/frontend/machine_registry.cpp)
  set(header "// Generated by ports/common/dsp_port.cmake: drivers built into ${target}.\n#pragma once\n")
  foreach(d IN LISTS drivers)
    if(NOT DEFINED DSP_PORT_SOURCES_${d})
      message(FATAL_ERROR "dsp port: ${d} is missing from driver_sources.cmake (run tools/driver_sources.py)")
    endif()
    list(APPEND rel ${DSP_PORT_SOURCES_${d}})
    string(TOUPPER "${d}" macro)
    string(MAKE_C_IDENTIFIER "${macro}" macro)
    string(APPEND header "#define DSP_DRIVER_${macro} 1\n")
  endforeach()
  list(REMOVE_DUPLICATES rel)

  set(sources "")
  set(musashi "")
  foreach(s IN LISTS rel)
    list(APPEND sources ${DSP_REPO}/${s})
    if(s MATCHES "^src/cpu/musashi/")
      list(APPEND musashi ${DSP_REPO}/${s})
    endif()
  endforeach()
  if(musashi)
    set_source_files_properties(${musashi} PROPERTIES COMPILE_OPTIONS "-w")
  endif()
  list(APPEND sources ${DSP_PORT_COMMON}/port_core.cpp ${DSP_PORT_COMMON}/memfs.cpp ${DSP_PORT_COMMON}/hid.cpp)
  if(ARG_EMBED)
    list(APPEND sources ${ARG_EMBED})
  else()
    list(APPEND sources ${DSP_REPO}/src/core/embedded_media_none.c)
  endif()

  if(ARG_ZLIB_DIR)
    foreach(z adler32 compress crc32 deflate inffast inflate inftrees trees uncompr zutil)
      list(APPEND sources ${ARG_ZLIB_DIR}/${z}.c)
      set_source_files_properties(${ARG_ZLIB_DIR}/${z}.c PROPERTIES COMPILE_OPTIONS "-w")
    endforeach()
    target_include_directories(${target} PRIVATE ${ARG_ZLIB_DIR})
  endif()

  set(gen_dir ${CMAKE_CURRENT_BINARY_DIR}/dsp_port/${target})
  file(WRITE ${gen_dir}/dsp_drivers.h.in "${header}")
  configure_file(${gen_dir}/dsp_drivers.h.in ${gen_dir}/dsp_drivers.h COPYONLY)

  target_sources(${target} PRIVATE ${sources})
  target_include_directories(${target} PRIVATE ${gen_dir} ${DSP_REPO}/src ${DSP_REPO}/src/cpu/musashi
                             ${DSP_PORT_COMMON})
  target_compile_definitions(${target} PRIVATE DSP_FS_POSIX=1)
  list(LENGTH drivers n)
  list(LENGTH rel n_src)
  string(REPLACE ";" " " names "${drivers}")
  message(STATUS "dsp port ${target}: ${n} driver(s) (${names}), ${n_src} dsp source files")
endfunction()
